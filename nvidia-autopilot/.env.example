# NVIDIA API key from build.nvidia.com — leave empty to run in simulation mode.
NVIDIA_API_KEY=

# NIM endpoints. Point both at a self-hosted NIM container to keep data on your GPUs.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_GENAI_BASE_URL=https://ai.api.nvidia.com/v1/genai

# Force simulation even when a key is present (1 = simulate, 0 = live)
NIM_SIMULATION=

# Server
PORT=8787
NVIDIA_AUTOPILOT_DATA_DIR=./data
NVIDIA_TIMEOUT_MS=180000
NVIDIA_MAX_CONCURRENCY=4

# Paperclip bridge (optional): push Company OS companies into a live Paperclip.
# Can also be saved in the UI — Settings per company → Paperclip bridge.
PAPERCLIP_API_BASE=
PAPERCLIP_API_KEY=

# Optional cost tracking (USD per 1M tokens)
NVIDIA_PRICE_INPUT_PER_MTOK=
NVIDIA_PRICE_OUTPUT_PER_MTOK=
