{
  "name": "paperclip-nim",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Paperclip clone where every agent, skill, blueprint and endpoint runs on NVIDIA NIM.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.mjs",
    "dev": "node --watch server/index.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node --check server/index.mjs",
    "sync:skills": "node scripts/sync-skills.mjs",
    "sync:models": "node scripts/sync-models.mjs",
    "bench": "node scripts/example-company.mjs"
  }
}
