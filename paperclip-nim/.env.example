# Paperclip × NVIDIA NIM
#
# Everything is optional. With no key the app boots in deterministic
# simulation mode so every screen and the full agent loop stay explorable.

# A key from https://build.nvidia.com (nvapi-...). The UI can also store keys
# in an encrypted-at-rest vault via Settings → API keys.
NVIDIA_API_KEY=

# NVIDIA hosted NIM endpoint. Self-hosted NIMs work too — point this at your
# own gateway, e.g. http://localhost:8000/v1
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# HTTP port. The server always binds 0.0.0.0 so previews/proxies work.
PORT=8790

# Force simulation even when a key exists (useful for demos/tests):
# FORCE_SIMULATION=1

# Default models used when a company is created without explicit routing.
# NIM_DEFAULT_CHAT=nvidia/nemotron-3-super-120b-a12b
# NIM_DEFAULT_REASONING=nvidia/nemotron-3-ultra-550b-a55b
# NIM_DEFAULT_EMBED=nvidia/nemotron-3.5-embed-8b
# NIM_DEFAULT_RERANK=nvidia/llama-3.1-nemotron-51b-instruct
# NIM_DEFAULT_IMAGE=google/diffusiongemma-26b-a4b-it
# NIM_DEFAULT_SAFETY=nvidia/nemotron-3.5-content-safety
